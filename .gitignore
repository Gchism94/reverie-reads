supabase/.branches/
supabase/.temp/

# OS / editor
.DS_Store
*.local
Thumbs.db
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
data/raw/Library_App_list.xlsx
data/raw/library_connected_series.csv

# Claude Design exports — large (multi-MB) and regenerable from Claude Design; kept local for
# reference, never tracked. Ignore every export shape consistently (.html and .dc.html alike).
# The README and any handoff/review .md stay tracked.
design/from-claude-design/**/*.html
design/from-claude-design/**/*.dc.html

# Keys and certificates — no legitimate tracked file has these shapes (pre-public audit §3)
*.pem
*.key
*.p12

# Vercel CLI project linkage (org/project ids) — never tracked
.vercel/

# git worktree checkouts — a full second working copy, never repo content
.worktrees/

# Discovery-audit output (screenshots + report), regenerated on each run — never committed.
apps/web/audit-output/
