# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed vars to the client.

# Supabase (local stack values come from `supabase status`).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Buy-link attribution (docs/SCALING.md). Default 'store' routes purchases to the reader's
# chosen local indie — the store keeps full profit, the app earns nothing. Set 'affiliate'
# (plus the ids below) only when you intend to earn a commission; that also surfaces a
# disclosure line. The ids are present-but-unused in 'store' mode.
VITE_BUY_ATTRIBUTION_MODE=store
VITE_BOOKSHOP_AFFILIATE_ID=
VITE_LIBRO_AFFILIATE_ID=
